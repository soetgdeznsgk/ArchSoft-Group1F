<mxCell id="v142" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="760" y="2030" width="1" height="1" as="geometry"/></mxCell>
<mxCell id="v143" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="850" y="2030" width="1" height="1" as="geometry"/></mxCell>
<mxCell id="e144" value="" style="endArrow=open;endSize=9;dashed=1;html=1;strokeColor=#333333;strokeWidth=1;fontSize=8;fontColor=#555555;labelBackgroundColor=#FFFFFF;edgeStyle=none;rounded=0;fontFamily=Helvetica;" edge="1" parent="1" source="v142" target="v143"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="v145" value="&lt;b&gt;«allowed to use»&lt;/b&gt;: el origen puede usar al destino. Siempre hacia abajo o hacia otro componente del mismo tier; nunca hacia arriba" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="864" y="2014" width="560" height="34" as="geometry"/></mxCell>
<mxCell id="v146" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="760" y="2088" width="1" height="1" as="geometry"/></mxCell>
<mxCell id="v147" value="" style="text;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="850" y="2088" width="1" height="1" as="geometry"/></mxCell>
<mxCell id="e148" value="" style="endArrow=open;endSize=9;dashed=1;dashPattern=2 3;html=1;strokeColor=#7F7F7F;strokeWidth=1;fontSize=8;fontColor=#555555;labelBackgroundColor=#FFFFFF;edgeStyle=none;rounded=0;fontFamily=Helvetica;" edge="1" parent="1" source="v146" target="v147"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="v149" value="&lt;b&gt;«allowed to use below»&lt;/b&gt;: salta una capa intermedia (en bololo_game, Aplicación → Infraestructura sin pasar por Dominio)" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="864" y="2072" width="560" height="34" as="geometry"/></mxCell>
<mxCell id="v150" value="Las flechas sin etiqueta entre componentes también son &lt;i&gt;allowed-to-use&lt;/i&gt;. La etiqueta se omite para no saturar el diagrama; el protocolo de cada relación está en la vista C&amp;amp;C (conectores C1–C21) y el detalle, en docs/layered-view.md." style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=12;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="2130" width="670" height="60" as="geometry"/></mxCell>
<mxCell id="v151" value="&lt;b&gt;RESTRICCIONES DEL ESTILO Y CÓMO SE CUMPLEN&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;Cada pieza en una sola capa.&lt;/b&gt; Cada archivo o clase aparece una vez. menu.js y chameleon.js están repartidos por secciones (vista, estado, red); es una deuda conocida del front.&lt;br&gt;• &lt;b&gt;Al menos dos capas.&lt;/b&gt; 3 tiers; cada componente con código tiene de 3 a 4 capas.&lt;br&gt;• &lt;b&gt;Sin relaciones hacia arriba ni ciclos.&lt;/b&gt; Tier 1 → Tier 2 → Tier 3. Dentro del Tier 2: proxy → gateway → servicios, SSR → Ranking, Bots → Auth/Lobby/Game, Lobby → Game. El antiguo ciclo Lobby ↔ Game se rompió publicando game.ended en RabbitMQ (commit 4fcb57e).&lt;br&gt;• &lt;b&gt;Atributos de calidad.&lt;/b&gt; Modificabilidad: cambiar la base de datos de un servicio solo toca su última capa. Portabilidad y reemplazo: el proxy y el gateway se cambian sin tocar los servicios. Seguridad: el Tier 3 solo es alcanzable desde la capa inferior de su dueño (escenario 3)." style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7F7F7F;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1500" y="1982" width="1460" height="330" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
