        <mxCell id="lgE7Txt" value="storage mount (named volume)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="640" y="1995" width="370" height="20" as="geometry" />
        </mxCell>
        <mxCell id="lgNote" value="A &lt;b&gt;communication path&lt;/b&gt; joins two nodes that exchange data at runtime. It is labelled only with the channel it uses (as «internet» / «intranet» in Bass et al.). The protocol, the direction and the content of each interaction are defined by the connectors of the C&amp;C view. Every path inside the host joins one container to one container (1 to 1)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="530" y="2035" width="470" height="120" as="geometry" />
        </mxCell>

        <!-- PORT MAPPING TABLE -->
        <mxCell id="portTable" value="&lt;div style=&quot;font-size:13px;font-weight:bold;margin-bottom:4px&quot;&gt;PORT MAPPING (host port → container port)&lt;/div&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;2&quot; style=&quot;border-collapse:collapse;width:100%;font-size:10px;&quot;&gt;&lt;tr style=&quot;background:#D9D9D9;font-weight:bold&quot;&gt;&lt;td&gt;Container&lt;/td&gt;&lt;td&gt;Container port&lt;/td&gt;&lt;td&gt;Host port&lt;/td&gt;&lt;td&gt;Docker networks&lt;/td&gt;&lt;td&gt;Note&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#E2F0D9&quot;&gt;&lt;td&gt;reverse-proxy&lt;/td&gt;&lt;td&gt;80/tcp&lt;/td&gt;&lt;td&gt;&lt;b&gt;80&lt;/b&gt;&lt;/td&gt;&lt;td&gt;public, edge&lt;/td&gt;&lt;td&gt;redirects to 443&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#E2F0D9&quot;&gt;&lt;td&gt;reverse-proxy&lt;/td&gt;&lt;td&gt;443/tcp&lt;/td&gt;&lt;td&gt;&lt;b&gt;443&lt;/b&gt;&lt;/td&gt;&lt;td&gt;public, edge&lt;/td&gt;&lt;td&gt;TLS 1.2 / 1.3, HTTP/2, certificate from certs/&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;reverse-proxy&lt;/td&gt;&lt;td&gt;8080/tcp&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;loopback only&lt;/td&gt;&lt;td&gt;healthcheck&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;traefik&lt;/td&gt;&lt;td&gt;8000/tcp&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;edge, internal&lt;/td&gt;&lt;td&gt;entryPoint web&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;traefik&lt;/td&gt;&lt;td&gt;8080/tcp&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;ping, healthcheck only&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;frontend&lt;/td&gt;&lt;td&gt;3000/tcp&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;internal&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;auth&lt;/td&gt;&lt;td&gt;8080/tcp&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;internal&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;lobby-manager&lt;/td&gt;&lt;td&gt;8000/tcp&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;internal&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;game-logic&lt;/td&gt;&lt;td&gt;8081/tcp&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;internal&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;bot-service&lt;/td&gt;&lt;td&gt;8090/tcp&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;internal&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ratings-service&lt;/td&gt;&lt;td&gt;8000/tcp&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;internal&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;rabbitmq&lt;/td&gt;&lt;td&gt;5672/tcp&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;internal&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;rabbitmq&lt;/td&gt;&lt;td&gt;15672/tcp&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;internal&lt;/td&gt;&lt;td&gt;management UI&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;auth-postgres&lt;/td&gt;&lt;td&gt;5432/tcp&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;internal&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;postgres&lt;/td&gt;&lt;td&gt;5432/tcp&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;internal&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;ratings-postgres&lt;/td&gt;&lt;td&gt;5432/tcp&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;internal&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;redis&lt;/td&gt;&lt;td&gt;6379/tcp&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;internal&lt;/td&gt;&lt;td&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;font-size:10px;margin-top:6px&quot;&gt;— = not mapped to the host. Only reverse-proxy has &lt;i&gt;ports:&lt;/i&gt; in docker-compose.yml. The edge and internal networks have &lt;i&gt;internal: true&lt;/i&gt;, so Docker cannot map their ports to the host.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;strokeColor=#000000;fillColor=#FFFFFF;spacing=8;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="1050" y="1700" width="3050" height="600" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
