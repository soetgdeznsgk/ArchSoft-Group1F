        <mxCell id="lgE5" value="«local socket»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#7F7F7F;strokeWidth=2;fontSize=10;fontColor=#7F7F7F;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;dashed=1;" edge="1" parent="1">
