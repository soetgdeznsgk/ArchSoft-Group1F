        <mxCell id="lgE7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;dashed=1;strokeWidth=1.5;strokeColor=#BF9000;fontSize=9;fontColor=#7F6000;labelBackgroundColor=#FFFFFF;jumpStyle=arc;jumpSize=10;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="530" y="2005" as="sourcePoint" /><mxPoint x="630" y="2005" as="targetPoint" /></mxGeometry>
