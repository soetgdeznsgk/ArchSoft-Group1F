        <!-- REVERSE PROXY · public + edge -->
        <mxCell id="nodeRp" value="«container» &lt;b&gt;reverse-proxy&lt;/b&gt;&lt;br&gt;image nginx:1.30.5-alpine&lt;br&gt;networks: public + edge (10.250.0.2)&lt;br&gt;ports &lt;b&gt;80:80&lt;/b&gt;, &lt;b&gt;443:443&lt;/b&gt;&lt;br&gt;8080/tcp on 127.0.0.1 (healthz)&lt;br&gt;read-only root filesystem&lt;br&gt;tmpfs: /run, /tmp, /var/cache/nginx,&lt;br&gt;/etc/nginx/conf.d&lt;br&gt;cap_drop ALL, adds NET_BIND_SERVICE,&lt;br&gt;CHOWN, SETUID, SETGID, DAC_OVERRIDE&lt;br&gt;no-new-privileges · nofile 16384&lt;br&gt;bind mounts (ro): nginx.conf,&lt;br&gt;snippets, templates/, certs/&lt;br&gt;env HSTS_MAX_AGE, RATE_LIMIT&lt;br&gt;healthcheck wget :8080/healthz" style="verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;spacingRight=16;shape=cube;size=12;direction=south;html=1;whiteSpace=wrap;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=10;verticalAlign=bottom;spacingBottom=8;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="640" y="500" width="240" height="680" as="geometry" />
        </mxCell>
        <mxCell id="exRp" value="«executionEnvironment»&lt;br&gt;&lt;b&gt;Nginx 1.30.5&lt;/b&gt; (Alpine)&lt;br&gt;worker_processes auto&lt;br&gt;4096 connections / worker&lt;br&gt;:80 → redirect to 443&lt;br&gt;:443 TLS 1.2 / 1.3, HTTP/2&lt;br&gt;per-IP rate and&lt;br&gt;connection limits" style="verticalAlign=middle;align=left;spacingLeft=8;spacingRight=14;shape=cube;size=8;direction=south;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#595959;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="652" y="540" width="216" height="240" as="geometry" />
        </mxCell>

        <!-- TRAEFIK · edge + internal -->
        <mxCell id="nodeTraefik" value="«container» &lt;b&gt;traefik&lt;/b&gt;&lt;br&gt;image traefik:v3.7.14&lt;br&gt;networks: edge (10.250.0.3)&lt;br&gt;+ internal&lt;br&gt;port 8000/tcp · not mapped&lt;br&gt;8080/tcp ping · not mapped&lt;br&gt;bind mounts (ro): traefik.yml,&lt;br&gt;/var/run/docker.sock&lt;br&gt;healthcheck: traefik&lt;br&gt;healthcheck --ping" style="verticalAlign=top;align=left;spacingTop=8;spacingLeft=8;spacingRight=16;shape=cube;size=12;direction=south;html=1;whiteSpace=wrap;fillColor=#F8CECC;strokeColor=#B85450;fontSize=10;verticalAlign=bottom;spacingBottom=8;strokeWidth=2;" vertex="1" parent="1">
