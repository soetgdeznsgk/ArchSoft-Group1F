resolver 127.0.0.11 valid=10s ipv6=off;

# Límite de tasa por IP (escenario 5). La clave es la IP del cliente; con RATE_LIMIT=off
# queda vacía y Nginx no cuenta la petición (para las pruebas de carga con k6 desde una sola IP).
map "${RATE_LIMIT}" $rl_key {
    off     "";
    default $binary_remote_addr;
}

# Para security-headers.conf, que no pasa por envsubst.
map "${HSTS_MAX_AGE}" $hsts_max_age {
    default "${HSTS_MAX_AGE}";
}

# login, register y password: relleno de credenciales probando muchos usuarios. El bloqueo
# por cuenta de auth (5 fallos) no lo frena, porque cada usuario tiene sus propios intentos.
limit_req_zone $rl_key zone=auth_cred:10m rate=10r/m;
# El resto de /auth/ (guest, me): una sesión de invitado por pestaña.
limit_req_zone $rl_key zone=auth:10m rate=30r/m;
# /api/: un jugador hace unas pocas peticiones por acción; el SSE cuenta como una sola.
limit_req_zone $rl_key zone=api:10m rate=20r/s;
# SSE y WebSocket son una petición cada uno: este límite evita que una IP retenga miles de streams.
limit_conn_zone $rl_key zone=perip:10m;

limit_req_status 429;
limit_conn_status 429;

upstream gateway {
    zone gateway 64k;
    server traefik:8000 resolve;
    keepalive 16;
}

server {
    listen 80 reuseport default_server;
    server_name _;

    location / {
        if ($request_method !~ ^(GET|HEAD)$) {
            return 308 https://$host$request_uri;
        }
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl reuseport default_server;
    http2 on;
    server_name _;

    ssl_certificate /certs/bololo.crt;
    ssl_certificate_key /certs/bololo.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1h;
    ssl_session_tickets off;

    # En un archivo aparte porque @rate_limited agrega Retry-After: en Nginx, una location con
    # add_header propio pierde todos los add_header del server.
    include /etc/nginx/snippets/security-headers.conf;

    proxy_http_version 1.1;
    proxy_hide_header X-Powered-By;
    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header Referrer-Policy;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;

    location = / {
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_set_header Connection "";
        proxy_pass http://gateway;
    }

    location ~ ^/(menu|ingame|chameleon)$ {
        return 301 /$1/;
    }

    # Páginas y archivos estáticos: sin límite de tasa (una página carga una decena de archivos).
    location ~ ^/(menu|ingame|chameleon|libraries)/ {
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_set_header Connection "";
        proxy_pass http://gateway;
    }

    location ~ ^/auth/(login|register|password)$ {
        limit_req zone=auth_cred burst=20 nodelay;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_set_header Connection "";
        proxy_pass http://gateway;
    }

    location /auth/ {
        limit_req zone=auth burst=30 nodelay;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_set_header Connection "";
        proxy_pass http://gateway;
    }

    location /api/ {
        limit_req zone=api burst=40 nodelay;
        limit_conn perip 100;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_set_header Connection "";
        proxy_read_timeout 75s;
        proxy_pass http://gateway;
    }

    location /ws/games/ {
        limit_conn perip 100;
        include /etc/nginx/snippets/proxy-headers.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_send_timeout 75s;
        proxy_read_timeout 75s;
        proxy_pass http://gateway;
    }

    location / {
        default_type application/json;
        return 404 '{"error":"not_found"}\n';
    }

    # Respuesta de limit_req y limit_conn: se responde aquí, sin llegar al gateway. El menú
    # muestra "message", y el código distingue este 429 del bloqueo por cuenta de auth.
    error_page 429 = @rate_limited;
    location @rate_limited {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Retry-After 10 always;
        default_type application/json;
        return 429 '{"error":"rate_limited","message":"Demasiadas peticiones. Espera unos segundos e inténtalo de nuevo."}\n';
    }
}

server {
    listen 127.0.0.1:8080;
    access_log off;

    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }
}
