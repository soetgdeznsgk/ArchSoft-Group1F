    "/healthz": {
      "get": {
        "tags": [
          "salud"
        ],
        "summary": "Healthz",
        "description": "Solo para Docker: no se publica en el gateway.",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/session": {
      "get": {
        "tags": [
          "sesión"
        ],
        "summary": "Get Session",
        "description": "Quién soy y en qué sala estoy. Sirve para restaurar la pantalla tras recargar la página.",
        "operationId": "get_session_api_session_get",
        "responses": {
          "200": {
            "description": "Successful Response",
