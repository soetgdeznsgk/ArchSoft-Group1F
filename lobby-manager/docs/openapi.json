                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/lobbies": {
      "get": {
        "tags": [
          "salas"
        ],
        "summary": "List Lobbies",
        "description": "Salas en espera, con su código y cantidad de jugadores. Las llenas traen playerCount == maxPlayers.",
