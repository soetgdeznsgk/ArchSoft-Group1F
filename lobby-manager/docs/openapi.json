  "components": {
    "schemas": {
      "AuthSessionIn": {
        "properties": {
          "accountId": {
            "type": "string",
            "title": "Accountid",
            "examples": [
              "34f1f808-6934-4c15-a267-b6f427cef015"
            ]
          },
          "nickname": {
            "type": "string",
            "title": "Nickname",
            "examples": [
              "ana"
            ]
          }
        },
        "type": "object",
        "required": [
          "accountId",
          "nickname"
        ],
        "title": "AuthSessionIn"
      },
      "CreateLobbyIn": {
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "CLASSIC",
              "CHAMELEON"
            ],
            "title": "Mode",
            "description": "CLASSIC (4 jugadores) o CHAMELEON (2 a 4 jugadores).",
            "default": "CLASSIC"
          }
        },
        "type": "object",
        "title": "CreateLobbyIn"
      },
      "ErrorOut": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "examples": [
              "lobby_full"
            ]
          },
          "message": {
            "type": "string",
            "title": "Message",
            "examples": [
              "La sala está llena."
            ]
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorOut"
      },
      "GameAccess": {
        "properties": {
          "gameId": {
            "type": "string",
            "title": "Gameid",
            "examples": [
              "g_7f3a9c1e2b4d"
            ]
          },
          "mode": {
            "type": "string",
            "enum": [
              "CLASSIC",
              "CHAMELEON"
            ],
            "title": "Mode",
            "description": "Modo de la partida: decide qué pantalla abre el cliente."
          },
          "wsPath": {
            "type": "string",
            "title": "Wspath",
            "examples": [
              "/ws/games/g_7f3a9c1e2b4d"
            ]
          },
          "token": {
            "type": "string",
            "title": "Token",
            "description": "JWT del jugador para Go; va en ?token= al abrir el WebSocket."
          }
        },
        "type": "object",
        "required": [
          "gameId",
          "mode",
          "wsPath",
          "token"
        ],
        "title": "GameAccess",
        "description": "Lo que el cliente necesita para abrir el WebSocket de la partida."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JoinByCodeIn": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "examples": [
              "K7QM2X"
            ]
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "JoinByCodeIn"
      },
      "Lobby": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "examples": [
              "l_0c5d8e1f2a3b"
            ]
          },
          "code": {
            "type": "string",
            "title": "Code",
            "examples": [
              "K7QM2X"
            ]
