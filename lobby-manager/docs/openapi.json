        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "salas"
        ],
        "summary": "Create Lobby",
        "description": "Crea una sala del modo elegido y deja al jugador dentro.\n\nEl cuerpo es opcional: sin él la sala es CLASSIC. 409 `lobby_limit_reached` si ya hay 10 salas.",
        "operationId": "create_lobby_api_lobbies_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/CreateLobbyIn"
